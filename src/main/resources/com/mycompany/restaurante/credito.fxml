<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" 
     xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.restaurante.CreditosController">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
    <VBox fx:id="card" alignment="CENTER" spacing="20.0">
        <children>
            <Label text="Jogo"/>
            <Label text="Restaurante Amalgamado"/>
            
            <Label text="Participantes"/>
            <Label text="Jonatã Sousa"/>
            <Label text="Joyce Cristina"/>
            <Label text="Rebeca Azambuja"/>
            
            <Label text="Disciplina"/>
            <Label text="Tópicos de Linguagem de Programação (TLP)"/>
            
            <Label text="Tecnologias"/>
            <Label text="Java"/>
            <Label text="CSS"/>
            
            <Button StyleClass="basic" text="Voltar" onAction="#voltar"/>
        </children>
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
    </VBox>
</VBox>
