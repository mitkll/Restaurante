<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<StackPane prefWidth="600.0" prefHeight="400.0"
           xmlns="http://javafx.com/javafx/8.0.171"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:id="j"
           fx:controller="com.mycompany.restaurante.Controller.JogoController">

    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>

    <VBox alignment="CENTER_LEFT" StackPane.alignment="CENTER_LEFT">
        <Label fx:id="p1" text=""/>
        <Label fx:id="t1" text=""/>
        <ImageView fx:id="monstro1" fitHeight="300" preserveRatio="true"/>
    </VBox>
    <VBox alignment="CENTER" StackPane.alignment="CENTER">
        <Label fx:id="p2" text=""/>
        <Label fx:id="t2" text=""/>
        <ImageView fx:id="monstro2" fitHeight="300" preserveRatio="true"/>
    </VBox>
    <VBox alignment="CENTER_RIGHT" StackPane.alignment="CENTER_RIGHT">
        <Label fx:id="p3" text=""/>
        <Label fx:id="t3" text=""/>
        <ImageView fx:id="monstro3" fitHeight="300" preserveRatio="true"/>
    </VBox>
    
    <VBox fx:id="jogo" alignment="TOP_CENTER" spacing="5.0">
        <padding>
            <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
        </padding>
        <Label fx:id="h" text="00:00"/>
        <Label fx:id="d" text="1"/>
    </VBox>

    <HBox alignment="BOTTOM_RIGHT" spacing="10.0">
        <padding>
            <Insets top="10.0" right="20.0" bottom="20.0" left="10.0"/>
        </padding>
        <Button styleClass="basic" fx:id="loja" text="Loja[I]" onAction="#loja"/>
        <Button styleClass="basic" fx:id="sair" text="Sair[ESC]" onAction="#sair"/>
    </HBox>

</StackPane>