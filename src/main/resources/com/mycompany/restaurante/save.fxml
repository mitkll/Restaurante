<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" 
     xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.restaurante.SaveController">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    
    <VBox fx:id="card" alignment="CENTER" spacing="20.0">
        <children>
            <Label text="blablabla"/>
            
            <Button fx:id="voltar" text="Voltar" onAction="#voltar"/>
        </children>
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
    </VBox>
</VBox>
