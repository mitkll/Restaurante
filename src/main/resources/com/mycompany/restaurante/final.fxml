<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" 
      fx:id="final" fx:controller="com.mycompany.restaurante.Controller.FinalController">
    <stylesheets>
        <URL value="@style.css" />
    </stylesheets>
    <VBox fx:id="card" alignment="CENTER" spacing="20.0">
        <Label text="Total do dia"/>
        <HBox>
            <Label fx:id="gasto" text="Gastos: "/>
            <Label fx:id="g" text="a"/>
        </HBox>
        <HBox>
            <Label fx:id="conta" text="Contas: "/>
            <Label fx:id="c" text="a"/>
        </HBox>
        <HBox>
            <Label fx:id="dinheiro" text="Recebido: "/>
            <Label fx:id="d" text="a"/>
        </HBox>
        <HBox>
            <Label fx:id="total" text="Total: "/>
            <Label fx:id="valorT" text="a"/>
        </HBox>
        <HBox>
            <Button styleClass="basic" text="Próximo dia" onAction="#continuar" />
            <Button styleClass="basic" text="Sair" onAction="#sair" />
        </HBox>
    </VBox>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
